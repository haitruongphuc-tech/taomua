# Kết nối PostgreSQL
DATABASE_URL=postgres://taomua:taomua_dev@localhost:5432/taomua
# Mật khẩu ban đầu cho tài khoản CEO khi chạy seed (bỏ trống thì seed tự sinh và in ra một lần)
SEED_CEO_PASSWORD=
# Telegram duyệt đơn (để trống thì hệ thống chỉ ghi nhật ký, không gửi)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Thông tin nhận tiền hiển thị cho khách (bổ sung sau khi có tài khoản nhận tiền)
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NO=
PAYMENT_ACCOUNT_NAME=
INTERNAL_API_KEY=
# --- AI ngôn ngữ (nhập sau). Mặc định Qwen trên Alibaba Cloud DashScope; dùng được OpenAI bằng cách đổi BASE_URL/MODEL.
AI_API_KEY=
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-max
# Tỷ giá tệ → đồng cho RYN-NEGO (nhập sau; trống thì dùng tạm 3500 và đánh dấu giả lập)
CNY_VND_RATE=
# --- Bán thật (nhập sau) ---
# Địa chỉ web chính thức, phải là https khi nhận tiền thật
SITE_URL=
# Khách quốc tế: mã SWIFT tài khoản nhận tiền và tỷ giá USD tham khảo
PAYMENT_SWIFT=
USD_VND_RATE=
# --- Báo duyệt One-Tap qua kênh phụ (spec 06_APPROVAL_SYSTEM.md; nhập sau) ---
# Zalo OA: access token của OA và user id Zalo của CEO (người đã quan tâm OA)
ZALO_OA_ACCESS_TOKEN=
ZALO_CEO_USER_ID=
# Email SMTP (ví dụ Gmail: smtp.gmail.com, cổng 465, mật khẩu ứng dụng)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
APPROVAL_EMAIL_TO=
